<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份/迁移排除规则：vault 只在本机 Keystore 下可解，不能被云备份带走 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
